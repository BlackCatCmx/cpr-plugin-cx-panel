{
  "manifestVersion": 2,
  "name": "cx-panel",
  "displayName": "Codex 额度面板",
  "publisher": "blackcatcmx",
  "version": "0.2.0",
  "description": "展示 Codex 额度并管理账号调度状态",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.18.2, <4.0.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": { "management": {} },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "admin_username": { "type": "string", "title": "管理员用户名", "default": "" },
      "admin_password": { "type": "string", "title": "管理员密码", "minLength": 1 },
      "admin_port": { "type": "integer", "title": "CPR 内部端口", "minimum": 1, "maximum": 65535, "description": "留空时使用 CPR_SERVER_PORT，未设置时使用 8080" }
    },
    "required": ["admin_password"],
    "additionalProperties": false
  },
  "secretFields": ["admin_password"],
  "resources": {
    "web/index.html": "text/html",
    "web/app.css": "text/css",
    "web/app.js": "text/javascript"
  }
}
