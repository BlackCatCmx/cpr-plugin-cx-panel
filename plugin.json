{
  "manifestVersion": 1,
  "name": "cx-panel",
  "displayName": "Codex 额度面板",
  "publisher": "blackcatcmx",
  "version": "0.1.0",
  "description": "展示 Codex 被动额度和令牌中的套餐信息",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.15.2, <4.0.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": { "management": {} },
  "permissions": ["accounts", "data"],
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.css": "text/css",
    "web/app.js": "text/javascript"
  }
}
